{
  "annotations": {
    "list": []
  },
  "description": "Kafka SDK Monitoring Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "rate(kafka_sdk_producer_messages_sent_total[5m])",
          "legendFormat": "Messages/sec",
          "refId": "A"
        }
      ],
      "title": "Producer Throughput",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ms"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(kafka_sdk_producer_send_latency_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(kafka_sdk_producer_send_latency_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(kafka_sdk_producer_send_latency_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Producer Latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {
          "expr": "rate(kafka_sdk_consumer_messages_consumed_total[5m])",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Throughput by Topic",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "kafka_sdk_consumer_lag",
          "legendFormat": "{{topic}}-{{partition}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Lag",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "Closed"}}, "type": "value"},
            {"options": {"1": {"text": "Open"}}, "type": "value"},
            {"options": {"2": {"text": "Half-Open"}}, "type": "value"}
          ]
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {
          "expr": "kafka_sdk_circuit_breaker_state",
          "legendFormat": "Circuit Breaker",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker State",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
      "id": 6,
      "targets": [
        {
          "expr": "rate(kafka_sdk_producer_errors_total[5m])",
          "legendFormat": "Errors/sec",
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
      "id": 7,
      "targets": [
        {
          "expr": "kafka_sdk_dlq_messages_total",
          "legendFormat": "DLQ Messages",
          "refId": "A"
        }
      ],
      "title": "Dead Letter Queue",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
      "id": 8,
      "targets": [
        {
          "expr": "kafka_sdk_health_status",
          "legendFormat": "Health",
          "refId": "A"
        }
      ],
      "title": "Health Status",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "id": 9,
      "targets": [
        {
          "expr": "rate(kafka_sdk_backpressure_permits_available[5m])",
          "legendFormat": "Available Permits",
          "refId": "A"
        },
        {
          "expr": "rate(kafka_sdk_backpressure_rejected_total[5m])",
          "legendFormat": "Rejected",
          "refId": "B"
        }
      ],
      "title": "Backpressure Metrics",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["kafka", "sdk"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Kafka SDK Dashboard",
  "uid": "kafka-sdk",
  "version": 1,
  "weekStart": ""
}
